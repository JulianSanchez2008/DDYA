def parimp(m):
    if m % 2 == 0:
        print("Numero",m,"Elevado a la 2",m*m)
    if m % 2 != 0:
        print("Numero",m,"Elevado a la 3",m*m*m)
def multi(m,n):
    mult = 1
    if m > n:
        vc = n 
        while vc <= m:
            mult = mult * vc
            vc += 1
    if n > m:
        vc = m
        while vc <= m:
            mult = mult * vc
            vc += 1
    print("La multiplicacion es:", mult)
def sumatoria(m,n):
    suma = 0
    if m > n:
        vc = n
        while vc <= m:
            suma = suma + vc
            vc += 1
    if n > m:
        vc = m
        while vc <= n:
            suma = suma + vc
            vc += 1
        print("La sumatoria es:", suma)
def primos(m):
    divisores = 0
    vc = 1
    while vc < m:
        if m % vc == 0:
            divisores += 1
        vc += 1
    if divisores == 1:
        print("El numero",m," es primo")
    else:
        print("El numero",m," no es primo")

def fibo(m):
    fibo = 0
    i = 0
    x = 1
    vc = 0
    while vc < 100:
        fibo = i + x
        i = x
        x = fibo
        if m == fibo:
            print("El numero",m," es parte de fibonacci")
        vc += 1
